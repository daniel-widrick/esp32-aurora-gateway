/*
 * Copy this file to secrets.h and fill in your values, OR generate it with:
 *   python tools/gen_secrets.py
 * (which reads .wifi and .apikey from the repo root).
 *
 * secrets.h is gitignored - never commit real credentials.
 */

#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

/* Bearer token required on every state-changing endpoint. Generate a strong
 * random one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
 * Only meaningful because the API is TLS-only. */
#define API_KEY "change-me-to-a-long-random-token"
